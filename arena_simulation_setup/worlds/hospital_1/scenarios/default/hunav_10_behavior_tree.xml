<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="hunav_10_behavior_tree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="SetGoal">
      <input_port name="agent_id" type="int"/>
      <input_port name="target_x" type="double"/>
      <input_port name="target_y" type="double"/>
      <input_port name="goal_id" type="int"/>
    </Action>
    <Action ID="GoTo">
      <input_port name="agent_id" type="int"/>
      <input_port name="goal_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="tolerance" type="int"/>
    </Action>
    <Action ID="StopAndWaitTimerAction">
      <input_port name="agent_id" type="int"/>
      <input_port name="wait_duration" type="double"/>
    </Action>
  </TreeNodesModel>
  <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml"/>
  <BehaviorTree ID="hunav_10_behavior_tree">
    <Repeat num_cycles="10">
      <Sequence>
        <SetGoal agent_id="{id}" goal_id="0" target_x="13.0" target_y="24.0"/>
        <GoTo agent_id="{id}" goal_id="0" time_step="0.1" tolerance="0.2"/>
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="5.0" />
        <SetGoal agent_id="{id}" goal_id="1" target_x="16.5" target_y="23.0"/>
        <GoTo agent_id="{id}" goal_id="1" time_step="0.1" tolerance="0.2"/>
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="5.0" />
        <SetGoal agent_id="{id}" goal_id="26" target_x="15.0" target_y="25.5"/>
        <GoTo agent_id="{id}" goal_id="26" time_step="0.1" tolerance="0.2"/>
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="5.0" />
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
