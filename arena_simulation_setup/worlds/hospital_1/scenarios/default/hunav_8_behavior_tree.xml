<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="hunav_8_behavior_tree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="SetGoal">
      <input_port name="agent_id" type="int"/>
      <input_port name="target_x" type="double"/>
      <input_port name="target_y" type="double"/>
      <input_port name="goal_id" type="int"/>
    </Action>
    <Action ID="GoTo">
      <input_port name="agent_id" type="int"/>
      <input_port name="goal_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="tolerance" type="int"/>
    </Action>
  </TreeNodesModel>
  <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml"/>
  <BehaviorTree ID="hunav_8_behavior_tree">
    <Sequence>
      <SetGoal agent_id="{id}" goal_id="28" target_x="17.8" target_y="3.1"/>
      <GoTo agent_id="{id}" goal_id="28" time_step="0.1" tolerance="0.1" />
    </Sequence>
  </BehaviorTree>
</root>
