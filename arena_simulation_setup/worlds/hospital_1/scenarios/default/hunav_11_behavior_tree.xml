<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="hunav_11_behavior_tree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="SetGoal">
      <input_port name="agent_id" type="int"/>
      <input_port name="target_x" type="double"/>
      <input_port name="target_y" type="double"/>
      <input_port name="goal_id" type="int"/>
    </Action>
    <Action ID="GoTo">
      <input_port name="agent_id" type="int"/>
      <input_port name="goal_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="tolerance" type="int"/>
    </Action>
    <Action ID="StopAndWaitTimerAction">
      <input_port name="agent_id" type="int"/>
      <input_port name="wait_duration" type="double"/>
    </Action>
  </TreeNodesModel>
  <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml"/>
  <BehaviorTree ID="hunav_11_behavior_tree">
    <Repeat num_cycles="10">
      <Sequence>
        <SetGoal agent_id="{id}" goal_id="2" target_x="17.0" target_y="27.5"/>
        <GoTo agent_id="{id}" goal_id="2" time_step="0.1" tolerance="0.5"/>
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="10.0" />
        <SetGoal agent_id="{id}" goal_id="3" target_x="15.0" target_y="28.0"/>
        <GoTo agent_id="{id}" goal_id="3" time_step="0.1" tolerance="0.2"/>
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="10.0" />
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
