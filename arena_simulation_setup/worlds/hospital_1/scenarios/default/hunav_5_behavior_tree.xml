<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="hunav_5_behavior_tree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="SetGoal">
      <input_port name="agent_id" type="int"/>
      <input_port name="target_x" type="double"/>
      <input_port name="target_y" type="double"/>
      <input_port name="goal_id" type="int"/>
    </Action>
    <Action ID="GoTo">
      <input_port name="agent_id" type="int"/>
      <input_port name="goal_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="tolerance" type="int"/>
    </Action>
    <Action ID="StopAndWaitTimerAction">
      <input_port name="agent_id" type="int"/>
      <input_port name="wait_duration" type="double"/>
    </Action>
    <Action ID="ConversationFormation">
      <input_port name="main_agent_id" type="int"/>
      <input_port name="conversation_duration" type="double"/>
      <input_port name="goal" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="non_main_agent_ids" type="string"/>
    </Action>
  </TreeNodesModel>
  <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml"/>
  <BehaviorTree ID="hunav_5_behavior_tree">
    <Sequence>
      <!-- <ConversationFormation main_agent_id="3" conversation_duration="60.0" goal_id="9" time_step="0.1" non_main_agent_ids="4"/> -->
      <SetGoal agent_id="{id}" goal_id="27" target_x="6.5" target_y="27.0" />
      <GoTo agent_id="{id}" goal_id="27" time_step="0.1" tolerance="0.5" />
    </Sequence>
  </BehaviorTree>
</root>
