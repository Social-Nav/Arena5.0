<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="hunav_7_behavior_tree" BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="SetGoal">
      <input_port name="agent_id" type="int"/>
      <input_port name="target_x" type="double"/>
      <input_port name="target_y" type="double"/>
      <input_port name="goal_id" type="int"/>
    </Action>
    <Action ID="GoTo">
      <input_port name="agent_id" type="int"/>
      <input_port name="goal_id" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="tolerance" type="int"/>
    </Action>
    <Action ID="StopAndWaitTimerAction">
      <input_port name="agent_id" type="int"/>
      <input_port name="wait_duration" type="double"/>
    </Action>
    <Action ID="ConversationFormation">
      <input_port name="main_agent_id" type="int"/>
      <input_port name="conversation_duration" type="double"/>
      <input_port name="goal" type="int"/>
      <input_port name="time_step" type="double"/>
      <input_port name="non_main_agent_ids" type="string"/>
    </Action>
  </TreeNodesModel>
  <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml"/>
  <BehaviorTree ID="hunav_7_behavior_tree">
    <Sequence>
      <Sequence>
        <SetGoal agent_id="{id}" goal_id="21" target_x="8.5" target_y="4.0" />
        <GoTo agent_id="{id}" goal_id="21" time_step="0.1" tolerance="0.5" />
      </Sequence>
      <Sequence>
        <SetGoal agent_id="{id}" goal_id="22" target_x="6.5" target_y="2.0" />
        <GoTo agent_id="{id}" goal_id="22" time_step="0.1" tolerance="0.2" />
        <StopAndWaitTimerAction agent_id="{id}" wait_duration="25.0" />
      </Sequence>
      <Sequence>
        <SetGoal agent_id="{id}" goal_id="23" target_x="10.5" target_y="4.0" />
        <GoTo agent_id="{id}" goal_id="23" time_step="0.1" tolerance="0.5" />
        <SetGoal agent_id="{id}" goal_id="24" target_x="12.0" target_y="11.0" />
        <GoTo agent_id="{id}" goal_id="24" time_step="0.1" tolerance="0.5" />
        <SetGoal agent_id="{id}" goal_id="25" target_x="20.3" target_y="6.0" />
        <GoTo agent_id="{id}" goal_id="25" time_step="0.1" tolerance="0.5" />
      </Sequence>
    </Sequence>
  </BehaviorTree>
</root>
