{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-nav.github.io/Arena5.0/schemas/lisn-slow-loop-evidence-v1.json",
  "title": "Arena LISN deterministic slow-loop evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "policy_sha256",
    "episode_id",
    "tick_index",
    "scheduled_for_monotonic_ns",
    "decision",
    "reason_codes",
    "control_path",
    "execution_interface",
    "observation",
    "update_id",
    "snapshot_sha256",
    "previous_state_sha256",
    "requested_parameters",
    "before_parameters",
    "readback_parameters",
    "rollback_readback_parameters",
    "accepted_state_sha256",
    "timeline",
    "stage_deadlines_ns",
    "runtime_executed"
  ],
  "properties": {
    "schema": {"const": "arena.lisn_slow_loop_evidence"},
    "schema_version": {"const": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "episode_id": {"type": "string", "minLength": 1},
    "tick_index": {"type": "integer", "minimum": 0},
    "scheduled_for_monotonic_ns": {"type": "integer", "minimum": 0},
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "rolled_back",
        "faulted",
        "not_due",
        "missed_tick",
        "duplicate_noop"
      ]
    },
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "control_path": {"type": ["string", "null"]},
    "execution_interface": {"const": "nav2_follow_path_social_mpc"},
    "observation": {"type": ["object", "null"]},
    "update_id": {"type": ["string", "null"]},
    "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "previous_state_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "requested_parameters": {"type": ["object", "null"]},
    "before_parameters": {"type": ["object", "null"]},
    "readback_parameters": {"type": ["object", "null"]},
    "rollback_readback_parameters": {"type": ["object", "null"]},
    "accepted_state_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "timeline": {"type": ["object", "null"]},
    "stage_deadlines_ns": {"type": "object"},
    "runtime_executed": {"const": false}
  }
}
