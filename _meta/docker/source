#!/usr/bin/env bash

ARENA_WS_DIR="${ARENA_WS_DIR:-$(pwd)}"

export HOST_ARENA_WS_DIR="$ARENA_WS_DIR"
export ARENA_DIR="$ARENA_WS_DIR/src/Arena"
export ARENA_ROS_DISTRO=jazzy

export ARENA_IMAGE="arena:dev"
HOST_UID=$(id -u)
export HOST_UID
HOST_GID=$(id -g)
export HOST_GID
export ARENA_PROJECT_NAME="arena-$(basename "$ARENA_WS_DIR")"

xhost +local:docker >/dev/null 2>&1 || true

docker_env=""
docker_env="${docker_env} ARENA_PROJECT_NAME=$ARENA_PROJECT_NAME"
docker_env="${docker_env} ARENA_IMAGE=$ARENA_IMAGE"
docker_env="${docker_env} ARENA_WS_DIR=$ARENA_WS_DIR"
docker_env="${docker_env} HOST_UID=$HOST_UID"
docker_env="${docker_env} HOST_GID=$HOST_GID"
export docker_env

arena_docker_compose_files(){
    local compose_files=("$ARENA_DIR/_meta/docker/docker-compose.yaml")
    local installed_file="$ARENA_DIR/.installed"
    local feature
    local feature_compose

    if [ -f "$installed_file" ]; then
        while read -r feature; do
            [ -n "$feature" ] || continue
            feature_compose="$ARENA_DIR/_meta/docker/features/$feature/docker-compose.yaml"
            if [ -f "$feature_compose" ]; then
                compose_files+=("$feature_compose")
            fi
        done < "$installed_file"
    fi

    printf '%s\n' "${compose_files[@]}"
}
export -f arena_docker_compose_files

arena_docker_compose(){
    local compose_files=()
    local file
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        compose_files+=(-f "$file")
    done < <(arena_docker_compose_files)

    env $docker_env docker compose "${compose_files[@]}" --project-directory "$ARENA_WS_DIR" --project-name "$ARENA_PROJECT_NAME" "$@"
}
export -f arena_docker_compose

arena_service="arena"

do_run(){
    if [ "$1" == "-c" ]; then
        shift
        arena_docker_compose exec -T "$arena_service" /entrypoint.sh bash -c "$*"
    elif [ -t 0 ] && [ -t 1 ]; then
        if [ "$#" -eq 0 ]; then
            arena_docker_compose exec "$arena_service" /entrypoint.sh bash -i
        else
            arena_docker_compose exec "$arena_service" /entrypoint.sh bash -ic "$*"
        fi
    else
        arena_docker_compose exec -T "$arena_service" /entrypoint.sh bash -c "$*"
    fi
    return $?
}

do_run "$@"
