#!/usr/bin/env bash

ARENA_WS_DIR="${ARENA_WS_DIR:-$(pwd)}"

export HOST_ARENA_WS_DIR="$ARENA_WS_DIR"
export ARENA_DIR="$ARENA_WS_DIR/src/Arena"
export ARENA_ROS_DISTRO=jazzy

export ARENA_IMAGE="arena:dev"
HOST_UID=$(id -u)
export HOST_UID
HOST_GID=$(id -g)
export HOST_GID
HOST_DOCKER_GID=$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo "$HOST_GID")
export HOST_DOCKER_GID
export ARENA_PROJECT_NAME="arena-$(basename "$ARENA_WS_DIR")"

mkdir -p "$ARENA_DIR/.venv"
mkdir -p "$ARENA_WS_DIR/build" "$ARENA_WS_DIR/install" "$ARENA_WS_DIR/log" "$ARENA_WS_DIR/deps" "$ARENA_WS_DIR/outputs"
if [ ! -f "$ARENA_WS_DIR/.env" ] ; then
    touch "$ARENA_WS_DIR/.env"
fi

xhost +local:docker >/dev/null 2>&1 || true

docker_env=""
docker_env="${docker_env} ARENA_PROJECT_NAME=$ARENA_PROJECT_NAME"
docker_env="${docker_env} ARENA_IMAGE=$ARENA_IMAGE"
docker_env="${docker_env} ARENA_WS_DIR=$ARENA_WS_DIR"
docker_env="${docker_env} HOST_UID=$HOST_UID"
docker_env="${docker_env} HOST_GID=$HOST_GID"
docker_env="${docker_env} HOST_DOCKER_GID=$HOST_DOCKER_GID"
for name in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy ROS_APT_MIRROR HOST_SCENES_DIR; do
    if [ -n "${!name+x}" ]; then
        docker_env="${docker_env} ${name}=${!name}"
    fi
done
export docker_env

arena_docker_compose_files(){
    local compose_files=("$ARENA_DIR/_meta/docker/docker-compose.yaml")
    local installed_file="$ARENA_DIR/.installed"
    local feature
    local feature_compose

    if [ -f "$installed_file" ]; then
        while read -r feature; do
            [ -n "$feature" ] || continue
            feature_compose="$ARENA_DIR/_meta/docker/features/$feature/docker-compose.yaml"
            if [ -f "$feature_compose" ]; then
                compose_files+=("$feature_compose")
            fi
        done < "$installed_file"
    fi

    printf '%s\n' "${compose_files[@]}"
}
export -f arena_docker_compose_files

arena_docker_compose(){
    local compose_files=()
    local file
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        compose_files+=(-f "$file")
    done < <(arena_docker_compose_files)

    env $docker_env docker compose "${compose_files[@]}" --project-directory "$ARENA_WS_DIR" --project-name "$ARENA_PROJECT_NAME" "$@"
}
export -f arena_docker_compose

arena_service="arena"

wait_for_arena_container(){
    local container_id
    local state

    while true; do
        container_id="$(arena_docker_compose ps -q "$arena_service" 2>/dev/null || true)"
        if [ -n "$container_id" ] && arena_docker_compose exec -T "$arena_service" test -f /.built >/dev/null 2>&1; then
            return 0
        fi

        if [ -n "$container_id" ]; then
            state="$(docker inspect -f '{{.State.Status}}' "$container_id" 2>/dev/null || true)"
            if [ "$state" = "exited" ] || [ "$state" = "dead" ]; then
                arena_docker_compose logs --tail=200 "$arena_service" >&2 || true
                return 1
            fi
        fi

        sleep 2
    done
}

do_run(){
    arena_docker_compose up -d --remove-orphans --timeout 0 "$arena_service"
    wait_for_arena_container || return $?

    if [ "$1" == "-c" ]; then
        shift
        arena_docker_compose exec -T "$arena_service" /entrypoint.sh bash -c "$*"
    elif [ -t 0 ] && [ -t 1 ]; then
        if [ "$#" -eq 0 ]; then
            arena_docker_compose exec "$arena_service" /entrypoint.sh bash -i
        else
            arena_docker_compose exec "$arena_service" /entrypoint.sh bash -ic "$*"
        fi
    else
        arena_docker_compose exec -T "$arena_service" /entrypoint.sh bash -c "$*"
    fi
    return $?
}

do_run "$@"
