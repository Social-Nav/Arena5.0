#!/bin/bash -i

#!/bin/bash -i


name="isaac"

update(){
    echo "Updating $name..."
    arena_docker_compose build isaac
    arena_docker_compose up -d --remove-orphans --no-start isaac
}

install(){
    set -e

    pushd "$ARENA_DIR" > /dev/null
        git submodule update --init arena_isaac
    popd > /dev/null
    
    if ! grep -q "$name" "$INSTALLED" 2>/dev/null; then
        echo "$name" >> "$INSTALLED"
    fi

    arena update
    arena build
    update

    echo "Installed $name successfully."
}

uninstall(){
    #TODO
    echo not implemented, but unsetting flag
    pushd "$ARENA_DIR" > /dev/null
        git submodule deinit -f arena_isaac
    popd > /dev/null
    sed -i "/$name/d" "$INSTALLED"
}

source_fn(){
    if [[ ! "$ARENA_MODELS_FORMATS" =~ usd ]]; then
        export ARENA_MODELS_FORMATS="${ARENA_MODELS_FORMATS},usdz,usd,usda,usdc"
    fi
}

launch(){
    arena_docker_compose up -d --remove-orphans isaac
    trap 'arena_docker_compose stop isaac || true' EXIT INT TERM
    # Quote each argument before splicing it into the `bash -c` string. With a bare $*
    # the arguments are joined by spaces and every quote is lost, so an empty value passed
    # as --flag "" collapses to nothing and argparse reports "expected one argument".
    # Note the caller (arena feature, _meta/tools/source) must quote too -- both layers
    # splice into a -c string, so either one dropping quotes loses the value.
    local _args=""
    local _a
    for _a in "$@"; do
        _args+=" $(printf '%q' "$_a")"
    done
    arena_docker_compose exec -T isaac bash -c "source /opt/arena_ws/install/local_setup.bash && python3-arena /opt/arena_ws/build/arena_isaac/arena_isaac/run_isaacsim.py$_args" || return $?
}

# === MAIN SCRIPT ===
help(){
    echo "Usage: $name <install|update|uninstall|source|launch|exec>"
}
if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    install)
        install
        exit $?
    ;;
    update)
        update
        exit $?
    ;;
    uninstall)
        uninstall
        exit $?
    ;;
    source)
        source_fn
        return $?
    ;;
    launch)
        shift
        launch "$@"
        exit $?
    ;;
    exec)
        shift
        arena_docker_compose exec isaac "$@"
        exit $?
    ;;
    *)
        help
        exit 1
    ;;
esac
