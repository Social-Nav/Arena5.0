#!/bin/bash -i

export ARENA_WS_DIR="/opt/arena_ws"
export ARENA_VENV_DIR="/opt/venv"
export ARENA_FEATURES_DIR="$ARENA_WS_DIR/src/Arena/_meta/docker/features"
export PYTHON_BUILD_MIRROR_URL="${PYTHON_BUILD_MIRROR_URL:-https://mirrors.tuna.tsinghua.edu.cn/python}"
export PYTHON_BUILD_MIRROR_URL_SKIP_CHECKSUM="${PYTHON_BUILD_MIRROR_URL_SKIP_CHECKSUM:-1}"

if [ -d "$ARENA_VENV_DIR" ]; then
    case ":${PATH:-}:" in
        *:"$ARENA_VENV_DIR/bin":*) ;;
        *) export PATH="$ARENA_VENV_DIR/bin:${PATH:-}" ;;
    esac
    for site_packages in "$ARENA_VENV_DIR"/lib/python*/site-packages; do
        [ -d "$site_packages" ] || continue
        case ":${PYTHONPATH:-}:" in
            *:"$site_packages":*) ;;
            *) export PYTHONPATH="$site_packages${PYTHONPATH:+:$PYTHONPATH}" ;;
        esac
    done
fi

docker_env=""
docker_env="${docker_env} ARENA_PROJECT_NAME=$ARENA_PROJECT_NAME"
docker_env="${docker_env} ARENA_IMAGE=$ARENA_IMAGE"
docker_env="${docker_env} ARENA_WS_DIR=$ARENA_WS_DIR"
docker_env="${docker_env} ARENA_ROS_DISTRO=$ARENA_ROS_DISTRO"
docker_env="${docker_env} HOST_UID=$HOST_UID"
docker_env="${docker_env} HOST_GID=$HOST_GID"
docker_env="${docker_env} HOST_DOCKER_GID=$HOST_DOCKER_GID"
docker_env="${docker_env} HOST_ARENA_WS_DIR=$HOST_ARENA_WS_DIR"
for name in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy ROS_APT_MIRROR PYTHON_BUILD_MIRROR_URL PYTHON_BUILD_MIRROR_URL_SKIP_CHECKSUM HOST_SCENES_DIR; do
    if [ -n "${!name+x}" ]; then
        docker_env="${docker_env} ${name}=${!name}"
    fi
done


export docker_env

HOST_UID=$(id -u)
export HOST_UID
HOST_GID=$(id -g)
export HOST_GID

arena_docker_compose_files(){
    local compose_files=("$ARENA_DIR/_meta/docker/docker-compose.yaml")
    local installed_file="$ARENA_DIR/.installed"
    local feature
    local feature_compose

    if [ -f "$installed_file" ]; then
        while read -r feature; do
            [ -n "$feature" ] || continue
            feature_compose="$ARENA_DIR/_meta/docker/features/$feature/docker-compose.yaml"
            if [ -f "$feature_compose" ]; then
                compose_files+=("$feature_compose")
            fi
        done < "$installed_file"
    fi

    printf '%s\n' "${compose_files[@]}"
}
export -f arena_docker_compose_files

arena_docker_compose(){
    local compose_files=()
    local file
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        compose_files+=(-f "$file")
    done < <(arena_docker_compose_files)

    sudo env ${docker_env} \
        docker compose \
        "${compose_files[@]}" \
        --project-directory "$ARENA_WS_DIR" \
        --project-name "$ARENA_PROJECT_NAME" \
        "$@"
}
export -f arena_docker_compose

source src/Arena/_meta/tools/source
