#!/bin/bash -i

name="internnav"

if ! declare -F arena_docker_compose >/dev/null 2>&1; then
    arena_docker_compose(){
        local ws_dir arena_dir project image host_uid host_gid
        ws_dir="${HOST_ARENA_WS_DIR:-${ARENA_WS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../../../../.." && pwd)}}"
        arena_dir="${ARENA_DIR:-$ws_dir/src/Arena}"
        project="${ARENA_PROJECT_NAME:-arena-$(basename "$ws_dir")}"
        image="${ARENA_IMAGE:-arena:dev}"
        host_uid="${HOST_UID:-$(id -u)}"
        host_gid="${HOST_GID:-$(id -g)}"
        env \
            ARENA_PROJECT_NAME="$project" \
            ARENA_IMAGE="$image" \
            ARENA_WS_DIR="$ws_dir" \
            HOST_ARENA_WS_DIR="$ws_dir" \
            HOST_UID="$host_uid" \
            HOST_GID="$host_gid" \
            ARENA_ROS_DISTRO="${ARENA_ROS_DISTRO:-jazzy}" \
            docker compose \
            -f "$arena_dir/_meta/docker/docker-compose.yaml" \
            -f "$arena_dir/_meta/docker/features/internnav/docker-compose.yaml" \
            --project-directory "$ws_dir" \
            --project-name "$project" \
            "$@"
    }
fi

feature_dir(){
    cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd
}

host_workspace_root(){
    if [ -n "${HOST_ARENA_WS_DIR:-}" ] && [ -d "$HOST_ARENA_WS_DIR" ]; then
        printf '%s\n' "$HOST_ARENA_WS_DIR"
    elif [ -n "${ARENA_WS_DIR:-}" ] && [ -d "$ARENA_WS_DIR" ]; then
        printf '%s\n' "$ARENA_WS_DIR"
    else
        pwd
    fi
}

container_workspace_root(){
    printf '%s\n' "${ARENA_WS:-${ARENA_WORKSPACE:-/opt/arena_ws}}"
}

venv_path(){
    printf '%s\n' "${ARENA_INTERNNAV_VENV:-/opt/internnav_venv}"
}

torch_index_url(){
    printf '%s\n' "${ARENA_INTERNNAV_TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu124}"
}

torch_packages(){
    printf '%s\n' "${ARENA_INTERNNAV_TORCH_PACKAGES:-torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0}"
}

ensure_installed_flag(){
    if ! grep -qx "$name" "$INSTALLED" 2>/dev/null; then
        echo "$name" >> "$INSTALLED"
    fi
}

default_model_path(){
    printf '%s\n' "${ARENA_INTERNNAV_MODEL_PATH:-/opt/arena_ws/deps/models/InternVLA-N1-DualVLN}"
}

default_depth_ckpt(){
    printf '%s\n' "${INTERNNAV_DEPTH_ANYTHING_CKPT:-/opt/arena_ws/deps/models/depth-anything-v2-metric-hypersim-small/depth_anything_v2_metric_hypersim_vits.pth}"
}

ros_double(){
    case "$1" in
        *.*|*e*|*E*) printf '%s\n' "$1" ;;
        ''|*[!0-9+-]*) printf '%s\n' "$1" ;;
        *) printf '%s.0\n' "$1" ;;
    esac
}

install_runtime(){
    set -e

    local root repo_path build_repo_path venv py torch_url torch_specs
    root="$(container_workspace_root)"
    repo_path="${ARENA_INTERNNAV_REPO:-$root/deps/InternNav}"
    venv="$(venv_path)"
    torch_url="$(torch_index_url)"
    torch_specs="$(torch_packages)"

    if [ ! -d "$repo_path" ]; then
        echo "InternNav repo not found at $repo_path" >&2
        return 1
    fi

    build_repo_path="/tmp/arena_internnav_src"

    if [ "${ARENA_INTERNNAV_RESET_VENV:-0}" = "1" ]; then
        mkdir -p "$venv"
        rm -rf "$venv"/* "$venv"/.[!.]* "$venv"/..?* 2>/dev/null || true
    fi
    if [ ! -x "$venv/bin/python" ]; then
        python3 -m venv --copies "$venv"
    fi
    py="$venv/bin/python"

    "$py" -m pip install --upgrade pip setuptools wheel
    if [ -n "$torch_specs" ]; then
        if [ -n "$torch_url" ]; then
            "$py" -m pip install --index-url "$torch_url" --upgrade $torch_specs
        else
            "$py" -m pip install --upgrade $torch_specs
        fi
    fi

    uv pip install --python "$py" -r "$repo_path/requirements/core_requirements.txt"
    uv pip install --python "$py" flask casadi scipy
    rm -rf "$build_repo_path"
    cp -a "$repo_path" "$build_repo_path"
    rm -rf "$build_repo_path"/internnav.egg-info "$build_repo_path"/*.egg-info
    uv pip install --python "$py" "$build_repo_path"

    local extra_specs=()
    local flash_attn_spec=""
    local requirement
    while IFS= read -r requirement; do
        requirement="${requirement%%#*}"
        requirement="$(printf '%s' "$requirement" | xargs)"
        [ -n "$requirement" ] || continue
        if [[ "$requirement" == flash_attn* || "$requirement" == flash-attn* ]]; then
            flash_attn_spec="$requirement"
        else
            extra_specs+=("$requirement")
        fi
    done < "$repo_path/requirements/internvla_n1.txt"

    if [ ${#extra_specs[@]} -gt 0 ]; then
        uv pip install --python "$py" "${extra_specs[@]}"
    fi

    # Re-apply the requested torch stack last because upstream dependencies may
    # otherwise upgrade it to an incompatible CUDA wheel.
    if [ -n "$torch_specs" ]; then
        if [ -n "$torch_url" ]; then
            "$py" -m pip install --index-url "$torch_url" --upgrade $torch_specs
        else
            "$py" -m pip install --upgrade $torch_specs
        fi
    fi

    if [ -n "$flash_attn_spec" ] && [ "${ARENA_INTERNNAV_INSTALL_FLASH_ATTN:-0}" = "1" ]; then
        "$py" -m pip install "$flash_attn_spec" || echo "Warning: flash-attn install failed; InternNav will use SDPA/eager fallbacks where supported."
    fi

    "$py" - <<'PY'
import json
import sys
summary = {'python': sys.version}
try:
    import torch
    summary.update({
        'torch': torch.__version__,
        'torch_cuda': torch.version.cuda,
        'cuda_available': torch.cuda.is_available(),
        'device_count': torch.cuda.device_count(),
    })
    if torch.cuda.device_count():
        try:
            summary['device0'] = torch.cuda.get_device_name(0)
        except Exception as exc:
            summary['device0_error'] = repr(exc)
except Exception as exc:
    summary['torch_error'] = repr(exc)
    print(json.dumps(summary, ensure_ascii=False))
PY

    "$py" - <<'PY'
import importlib

for module in (
    'arena_vln_models',
    'arena_vln_models.backends',
    'arena_vln_models.internnav',
):
    importlib.import_module(module)

print('InternNav runtime import smoke passed.')
PY

    if [ "$(id -u)" = "0" ] && id arena >/dev/null 2>&1; then
        chown -R "$(id -u arena):$(id -g arena)" "$venv" /home/arena/.cache 2>/dev/null || true
    fi
}

update(){
    echo "Building $name docker image..."
    arena_docker_compose build internnav
    arena_docker_compose up -d --remove-orphans --no-start internnav
}

install(){
    set -e
    ensure_installed_flag
    update
    echo "Installing InternNav runtime into the internnav service volume..."
    arena_docker_compose run --rm --no-deps --user root --entrypoint bash internnav -lc \
        "bash /opt/arena_ws/src/Arena/_meta/docker/features/internnav/main install-runtime"
    echo "Installed $name successfully."
}

uninstall(){
    sed -i "/^$name$/d" "$INSTALLED" 2>/dev/null || true
    arena_docker_compose rm -sf internnav 2>/dev/null || true
    echo "Removed $name feature flag. Named volumes are kept intentionally; remove them with docker volume rm if needed."
}

source_fn(){
    local root
    root="$(host_workspace_root)"
    export ARENA_INTERNNAV_MODEL_PATH="${ARENA_INTERNNAV_MODEL_PATH:-$root/deps/models/InternVLA-N1-DualVLN}"
    export ARENA_VLN_MODEL_PATH="${ARENA_VLN_MODEL_PATH:-$ARENA_INTERNNAV_MODEL_PATH}"
    export INTERNNAV_DEPTH_ANYTHING_CKPT="${INTERNNAV_DEPTH_ANYTHING_CKPT:-$root/deps/models/depth-anything-v2-metric-hypersim-small/depth_anything_v2_metric_hypersim_vits.pth}"
}

launch(){
    local robot namespace mode model_path device rgb_topic depth_topic camera_info_topic instruction_topic navigation_goal_topic eval_ready_topic task_reset_topic scenario_reset_topic trace_path status_topic visualization_topic action_visualization_topic model_output_topic model_output_policy visualization_rate_hz enable_visualization planning_rate_hz inference_rate_hz inference_timeout_sec camera_ready_timeout_sec internnav_http_url internnav_http_timeout_sec adapter_target extra_ros_args cmd_vel_topic cmd_vel_topic_explicit raw_cmd_vel_topic timing_mode odom_topic
    robot="${ARENA_INTERNNAV_ROBOT:-Ai2_Bot2}"
    namespace="${ARENA_INTERNNAV_NAMESPACE:-/task_generator_node/$robot}"
    mode="${ARENA_INTERNNAV_MODE:-internnav}"
    model_path="${ARENA_INTERNNAV_MODEL_PATH:-$(default_model_path)}"
    device="${ARENA_INTERNNAV_DEVICE:-cuda:0}"
    rgb_topic="${ARENA_INTERNNAV_RGB_TOPIC:-head_camera/image}"
    depth_topic="${ARENA_INTERNNAV_DEPTH_TOPIC:-head_camera/depth}"
    camera_info_topic="${ARENA_INTERNNAV_CAMERA_INFO_TOPIC:-head_camera/camera_info}"
    odom_topic="${ARENA_INTERNNAV_ODOM_TOPIC:-odom}"
    cmd_vel_topic="${ARENA_INTERNNAV_CMD_VEL_TOPIC:-cmd_vel}"
    cmd_vel_topic_explicit="false"
    raw_cmd_vel_topic="${ARENA_INTERNNAV_RAW_CMD_VEL_TOPIC:-${ARENA_EVAL_INTERNNAV_RAW_CMD_VEL_TOPIC:-internnav/raw_cmd_vel}}"
    timing_mode="${ARENA_INTERNNAV_TIMING_MODE:-${ARENA_EVAL_INTERNNAV_TIMING_MODE:-wall}}"
    instruction_topic="${ARENA_INTERNNAV_INSTRUCTION_TOPIC:-/task_generator_node/vln_instruction}"
    navigation_goal_topic="${ARENA_INTERNNAV_NAVIGATION_GOAL_TOPIC:-episode_goal_pose}"
    eval_ready_topic="${ARENA_INTERNNAV_EVAL_READY_TOPIC:-/task_generator_node/eval_ready}"
    task_reset_topic="${ARENA_INTERNNAV_TASK_RESET_TOPIC:-/task_generator_node/task_reset}"
    scenario_reset_topic="${ARENA_INTERNNAV_SCENARIO_RESET_TOPIC:-}"
    trace_path="${ARENA_INTERNNAV_TRACE_PATH:-${ARENA_EVAL_INTERNNAV_TRACE_PATH:-}}"
    status_topic="${ARENA_INTERNNAV_STATUS_TOPIC:-${ARENA_EVAL_INTERNNAV_STATUS_TOPIC:-internnav/status}}"
    visualization_topic="${ARENA_INTERNNAV_VISUALIZATION_TOPIC:-${ARENA_EVAL_INTERNNAV_VISUALIZATION_TOPIC:-internnav/debug_image}}"
    action_visualization_topic="${ARENA_INTERNNAV_ACTION_VISUALIZATION_TOPIC:-${ARENA_EVAL_INTERNNAV_ACTION_VISUALIZATION_TOPIC:-internnav/action_image}}"
    model_output_topic="${ARENA_INTERNNAV_MODEL_OUTPUT_TOPIC:-${ARENA_EVAL_INTERNNAV_MODEL_OUTPUT_TOPIC:-internnav/model_output}}"
    model_output_policy="${ARENA_INTERNNAV_MODEL_OUTPUT_POLICY:-${ARENA_EVAL_INTERNNAV_MODEL_OUTPUT_POLICY:-trajectory}}"
    visualization_rate_hz="${ARENA_INTERNNAV_VISUALIZATION_RATE_HZ:-${ARENA_EVAL_INTERNNAV_VISUALIZATION_RATE_HZ:-5.0}}"
    enable_visualization="${ARENA_INTERNNAV_ENABLE_VISUALIZATION:-${ARENA_EVAL_INTERNNAV_ENABLE_VISUALIZATION:-true}}"
    planning_rate_hz="${ARENA_INTERNNAV_PLANNING_RATE_HZ:-${ARENA_EVAL_INTERNNAV_PLANNING_RATE_HZ:-${ARENA_INTERNNAV_INFERENCE_RATE_HZ:-${ARENA_EVAL_INTERNNAV_INFERENCE_RATE_HZ:-3.3333333333}}}}"
    inference_rate_hz="$planning_rate_hz"
    inference_timeout_sec="${ARENA_INTERNNAV_INFERENCE_TIMEOUT_SEC:-120.0}"
    official_http="${ARENA_INTERNNAV_OFFICIAL_HTTP:-true}"
    http_host="${ARENA_INTERNNAV_HTTP_HOST:-127.0.0.1}"
    http_port="${ARENA_INTERNNAV_HTTP_PORT:-5801}"
    http_output_dir="${ARENA_INTERNNAV_HTTP_OUTPUT_DIR:-/tmp/internvla_http_output}"
    http_health_timeout_sec="${ARENA_INTERNNAV_HTTP_HEALTH_TIMEOUT_SEC:-600.0}"
    internnav_http_url="${ARENA_INTERNNAV_HTTP_URL:-}"
    internnav_http_timeout_sec="${ARENA_INTERNNAV_HTTP_TIMEOUT_SEC:-}"
    adapter_target="${ARENA_INTERNNAV_ADAPTER_TARGET:-}"
    camera_ready_timeout_sec="${ARENA_INTERNNAV_CAMERA_READY_TIMEOUT_SEC:-480.0}"
    extra_ros_args="${ARENA_INTERNNAV_EXTRA_ROS_ARGS:-}"

    while [ $# -gt 0 ]; do
        case "$1" in
            --robot) robot="$2"; namespace="/task_generator_node/$2"; shift 2 ;;
            --namespace) namespace="$2"; shift 2 ;;
            --mode) mode="$2"; shift 2 ;;
            --model-path) model_path="$2"; shift 2 ;;
            --device) device="$2"; shift 2 ;;
            --rgb-topic) rgb_topic="$2"; shift 2 ;;
            --depth-topic) depth_topic="$2"; shift 2 ;;
            --camera-info-topic) camera_info_topic="$2"; shift 2 ;;
            --odom-topic) odom_topic="$2"; shift 2 ;;
            --cmd-vel-topic) cmd_vel_topic="$2"; cmd_vel_topic_explicit="true"; shift 2 ;;
            --raw-cmd-vel-topic) raw_cmd_vel_topic="$2"; shift 2 ;;
            --timing-mode) timing_mode="$2"; shift 2 ;;
            --instruction-topic) instruction_topic="$2"; shift 2 ;;
            --navigation-goal-topic) navigation_goal_topic="$2"; shift 2 ;;
            --eval-ready-topic) eval_ready_topic="$2"; shift 2 ;;
            --task-reset-topic) task_reset_topic="$2"; shift 2 ;;
            --scenario-reset-topic) scenario_reset_topic="$2"; shift 2 ;;
            --trace-path) trace_path="$2"; shift 2 ;;
            --status-topic) status_topic="$2"; shift 2 ;;
            --visualization-topic) visualization_topic="$2"; shift 2 ;;
            --action-visualization-topic) action_visualization_topic="$2"; shift 2 ;;
            --model-output-topic) model_output_topic="$2"; shift 2 ;;
            --model-output-policy) model_output_policy="$2"; shift 2 ;;
            --visualization-rate-hz) visualization_rate_hz="$2"; shift 2 ;;
            --enable-visualization) enable_visualization="true"; shift ;;
            --disable-visualization) enable_visualization="false"; shift ;;
            --planning-rate-hz) planning_rate_hz="$2"; shift 2 ;;
            --inference-rate-hz) planning_rate_hz="$2"; inference_rate_hz="$2"; shift 2 ;;
            --inference-timeout-sec) inference_timeout_sec="$2"; shift 2 ;;
            --official-http) official_http="true"; shift ;;
            --no-official-http) official_http="false"; shift ;;
            --http-host) http_host="$2"; shift 2 ;;
            --http-port) http_port="$2"; shift 2 ;;
            --http-output-dir) http_output_dir="$2"; shift 2 ;;
            --http-health-timeout-sec) http_health_timeout_sec="$2"; shift 2 ;;
            --realworld-http-url|--http-url) internnav_http_url="$2"; adapter_target="arena_vln_models.internnav:load_internvla_realworld_http_adapter"; shift 2 ;;
            --realworld-http-timeout-sec|--http-timeout-sec) internnav_http_timeout_sec="$2"; shift 2 ;;
            --camera-ready-timeout-sec) camera_ready_timeout_sec="$2"; shift 2 ;;
            --) shift; extra_ros_args="$*"; break ;;
            *) echo "Unknown launch option: $1" >&2; return 1 ;;
        esac
    done

    visualization_rate_hz="$(ros_double "$visualization_rate_hz")"
    planning_rate_hz="$(ros_double "$planning_rate_hz")"
    inference_rate_hz="$planning_rate_hz"
    inference_timeout_sec="$(ros_double "$inference_timeout_sec")"
    if [ "$cmd_vel_topic_explicit" != "true" ] && [ "$(printf '%s' "$timing_mode" | tr '[:upper:]' '[:lower:]')" != "wall" ]; then
        cmd_vel_topic="$raw_cmd_vel_topic"
    fi
    if [ -z "$internnav_http_timeout_sec" ]; then
        internnav_http_timeout_sec="$inference_timeout_sec"
    fi
    internnav_http_timeout_sec="$(ros_double "$internnav_http_timeout_sec")"
    camera_ready_timeout_sec="$(ros_double "$camera_ready_timeout_sec")"
    http_health_timeout_sec="$(ros_double "$http_health_timeout_sec")"
    if [ "$official_http" = "true" ] && [ -z "$internnav_http_url" ]; then
        internnav_http_url="http://$http_host:$http_port/eval_dual"
    fi
    arena_docker_compose up -d --remove-orphans --no-recreate internnav
    trap 'arena_docker_compose stop internnav || true' EXIT INT TERM

    local cmd
    cmd="set -e; export ROS_DOMAIN_ID='${ROS_DOMAIN_ID:-1}'; export RMW_IMPLEMENTATION='${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}'; export ROS_AUTOMATIC_DISCOVERY_RANGE='${ROS_AUTOMATIC_DISCOVERY_RANGE:-SUBNET}'; export ROS_LOCALHOST_ONLY='${ROS_LOCALHOST_ONLY:-0}'; export FASTDDS_BUILTIN_TRANSPORTS='${FASTDDS_BUILTIN_TRANSPORTS:-UDPv4}'; export NO_PROXY='127.0.0.1,localhost,${NO_PROXY:-}'; export no_proxy='127.0.0.1,localhost,${no_proxy:-}'; export ARENA_INTERNNAV_MODEL_PATH='$model_path'; export ARENA_VLN_MODEL_PATH='$model_path'; export INTERNNAV_DEPTH_ANYTHING_CKPT='$(default_depth_ckpt)'; export ARENA_VLN_MODEL_PYTHON='$(venv_path)/bin/python'; export ARENA_INTERNNAV_PYTHON='$(venv_path)/bin/python'; export PYTHONPATH='/opt/arena_ws/deps/InternNav:/opt/arena_ws/deps/InternNav/third_party/diffusion-policy:'\"\${PYTHONPATH:-}\";"
    if [ -n "$trace_path" ]; then
        cmd="$cmd export ARENA_EVAL_INTERNNAV_TRACE_PATH='$trace_path';"
    fi
    if [ "$official_http" = "true" ]; then
        cmd="$cmd $(venv_path)/bin/python -u /opt/arena_ws/deps/InternNav/scripts/realworld/http_internvla_server.py --host '0.0.0.0' --port '$http_port' --device '$device' --model_path '$model_path' --output_dir '$http_output_dir' & official_http_pid=\$!; trap 'kill \$official_http_pid 2>/dev/null || true' EXIT INT TERM; health_attempts=\$($(venv_path)/bin/python -c \"import math; print(max(1, int(math.ceil(float('$http_health_timeout_sec') / 2.0))))\"); health_i=0; while ! $(venv_path)/bin/python -c \"import json, urllib.request; data=json.loads(urllib.request.urlopen('http://127.0.0.1:$http_port/health', timeout=2).read().decode('utf-8')); raise SystemExit(0 if data.get('status') == 'ready' else 1)\"; do health_i=\$((health_i + 1)); if [ \$health_i -ge \$health_attempts ]; then echo 'official InternVLA HTTP server did not become ready at http://127.0.0.1:$http_port/health' >&2; exit 1; fi; sleep 2; done;"
    fi
    case "$rgb_topic" in /*) ;; *) rgb_topic="$namespace/$rgb_topic" ;; esac
    case "$depth_topic" in /*) ;; *) depth_topic="$namespace/$depth_topic" ;; esac
    case "$camera_info_topic" in /*) ;; *) camera_info_topic="$namespace/$camera_info_topic" ;; esac
    case "$odom_topic" in /*) ;; *) odom_topic="$namespace/$odom_topic" ;; esac
    case "$cmd_vel_topic" in /*) ;; *) cmd_vel_topic="$namespace/$cmd_vel_topic" ;; esac
    case "$navigation_goal_topic" in /*) ;; *) navigation_goal_topic="$namespace/$navigation_goal_topic" ;; esac
    case "$status_topic" in ''|/*) ;; *) status_topic="$namespace/$status_topic" ;; esac
    case "$model_output_topic" in ''|/*) ;; *) model_output_topic="$namespace/$model_output_topic" ;; esac
    case "$visualization_topic" in ''|/*) ;; *) visualization_topic="$namespace/$visualization_topic" ;; esac
    case "$action_visualization_topic" in ''|/*) ;; *) action_visualization_topic="$namespace/$action_visualization_topic" ;; esac
    if [ -z "$scenario_reset_topic" ]; then
        # Arena's task_generator publishes /task_generator_node/task_reset as
        # the canonical episode boundary for this direct-cmd_vel eval path.
        # There is no per-robot scenario_reset publisher in
        # internnav_async_eval.launch.py, so default to task_reset instead of a
        # dead namespaced topic.
        scenario_reset_topic="$task_reset_topic"
    fi
    local visualization_flag="--disable-visualization"
    if [ "$enable_visualization" = "true" ]; then
        visualization_flag="--enable-visualization"
    fi
    cmd="$cmd cd /opt/arena_ws/deps/InternNav/scripts/realworld; $(venv_path)/bin/python -u http_internvla_client.py --url '$internnav_http_url' --rgb-topic '$rgb_topic' --depth-topic '$depth_topic' --odom-topic '$odom_topic' --cmd-vel-topic '$cmd_vel_topic' --instruction-topic '$instruction_topic' --camera-info-topic '$camera_info_topic' --navigation-goal-topic '$navigation_goal_topic' --eval-ready-topic '$eval_ready_topic' --task-reset-topic '$task_reset_topic' --scenario-reset-topic '$scenario_reset_topic' --status-topic '$status_topic' --model-output-topic '$model_output_topic' --visualization-topic '$visualization_topic' --action-visualization-topic '$action_visualization_topic' --visualization-rate-hz '$visualization_rate_hz' --planning-rate-hz '$planning_rate_hz' $visualization_flag --trace-path '$trace_path' $extra_ros_args"

    arena_docker_compose exec -T internnav /entrypoint.sh bash -lc "$cmd"
}

exec_cmd(){
    shift
    arena_docker_compose exec internnav "$@"
}

stop(){
    arena_docker_compose stop internnav
}

help(){
    cat <<EOF
Usage: $name <install|update|uninstall|source|launch|exec|stop|install-runtime>

Launch options:
  --robot NAME                  Default: Ai2_Bot2
  --namespace NS                Default: /task_generator_node/<robot>
  --mode MODE                   Default: internnav
  --model-path PATH             Default: /opt/arena_ws/deps/models/InternVLA-N1-DualVLN
  --device DEVICE               Default: cuda:0
  --rgb-topic TOPIC             Default: head_camera/image
  --depth-topic TOPIC           Default: head_camera/depth
  --camera-info-topic TOPIC     Default: head_camera/camera_info
  --odom-topic TOPIC            Default: odom
  --cmd-vel-topic TOPIC         Default: cmd_vel, or raw timing topic when --timing-mode is not wall
  --raw-cmd-vel-topic TOPIC     Default: internnav/raw_cmd_vel
  --timing-mode MODE            wall or sim_time_realworld. Default: wall
  --instruction-topic TOPIC     Default: /task_generator_node/vln_instruction
  --navigation-goal-topic TOPIC Default: episode_goal_pose
  --eval-ready-topic TOPIC      Default: /task_generator_node/eval_ready
  --task-reset-topic TOPIC      Default: /task_generator_node/task_reset
  --scenario-reset-topic TOPIC  Default: <namespace>/scenario_reset
  --trace-path PATH             Optional JSONL trace path
  --status-topic TOPIC          Default: internnav/status
  --enable-visualization        Publish debug overlay frames (default)
  --disable-visualization       Disable debug overlay frames
  --visualization-topic TOPIC   Default: internnav/debug_image
  --action-visualization-topic TOPIC Default: internnav/action_image
  --model-output-topic TOPIC    Default: internnav/model_output
  --visualization-rate-hz HZ    Default: 5.0
  --planning-rate-hz HZ         Outer realworld client /eval_dual request rate. Default: 3.3333333333
  --inference-rate-hz HZ        Deprecated alias for --planning-rate-hz
  --inference-timeout-sec SEC   Default: 120.0
  --official-http               Start upstream InternNav realworld HTTP server first (default)
  --no-official-http            Do not start upstream HTTP server; use an already running --realworld-http-url
  --http-host HOST              Hostname used by the ROS adapter URL. Default: 127.0.0.1
  --http-port PORT              Upstream HTTP server port. Default: 5801
  --http-output-dir DIR         Upstream HTTP server output dir. Default: /tmp/internvla_http_output
  --http-health-timeout-sec SEC Default: 600.0
  --realworld-http-url URL      Use InternVLA-N1 realworld HTTP /eval_dual via Arena ROS2 get_command
  --realworld-http-timeout-sec SEC Default: ARENA_INTERNNAV_HTTP_TIMEOUT_SEC or --inference-timeout-sec
  --camera-ready-timeout-sec SEC Default: 480.0
EOF
}

if [ $# -lt 1 ]; then
    help
    exit 1
fi

case "$1" in
    install) install; exit $? ;;
    update) update; exit $? ;;
    uninstall) uninstall; exit $? ;;
    source) source_fn; return $? ;;
    launch) shift; launch "$@"; exit $? ;;
    exec) exec_cmd "$@"; exit $? ;;
    stop) stop; exit $? ;;
    install-runtime) install_runtime; exit $? ;;
    *) help; exit 1 ;;
esac
