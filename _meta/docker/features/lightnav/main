#!/usr/bin/env bash
# Compatibility entry point; model runtime and adapters live in model repositories.
if [ "${1:-}" = source ]; then return 0 2>/dev/null || exit 0; fi
set -euo pipefail
feature_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
arena_dir=$(cd "$feature_dir/../../../.." && pwd)
export PYTHONPATH="$arena_dir/arena_vln_models:$arena_dir/arena_bringup${PYTHONPATH:+:$PYTHONPATH}"
# Preserve explicit --profile overrides.
case " $* " in *" --profile "*|*" --profile="*) ;; *)
    set -- --profile "$arena_dir/arena_bringup/configs/benchmark/profiles/lightnav_grscenes.yaml" "$@" ;;
esac
exec /usr/bin/python3 -m arena_vln_models.runner "$@"
