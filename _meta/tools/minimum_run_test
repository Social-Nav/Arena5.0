#!/usr/bin/env bash
set -euo pipefail

ROBOT="${ARENA_MIN_TEST_ROBOT:-jackal}"
WORLD="${ARENA_MIN_TEST_WORLD:-map_empty}"
LAUNCH_TIMEOUT_SEC="${ARENA_MIN_TEST_LAUNCH_TIMEOUT_SEC:-30}"
SKIP_DOCKER=0
SKIP_ENV=0
SKIP_ROBOT=1
CHECK_INSTALLED_FEATURES=0

usage(){
    cat <<EOF
Usage: arena minimum-test [options]

Minimum smoke test for a fresh Arena install. Run it from the host with:
  cd ~/arena_ws && source arena && arena minimum-test

Checks:
  1. Minimum Docker image / compose service for the Arena container.
  2. Arena ROS overlay and Python package imports.

Optional checks:
  - Installed feature images / compose services.
  - A short dummy-simulator robot launch reaches ROS node startup.

Options:
  --robot NAME              Robot for dummy launch smoke. Default: ${ROBOT}
  --world NAME              World for dummy launch smoke. Default: ${WORLD}
  --launch-timeout SEC      Max seconds for launch smoke. Default: ${LAUNCH_TIMEOUT_SEC}
  --skip-docker             Skip Docker image / compose checks.
  --skip-env                Skip ROS/Python environment checks.
  --include-installed-features
                            Also verify Docker images / compose services for entries in .installed.
  --with-robot-launch       Also run the dummy-simulator launch smoke.
  --skip-robot              Deprecated alias; robot launch is skipped by default.
  -h, --help                Show this help.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --robot)
            ROBOT="$2"
            shift 2
            ;;
        --world)
            WORLD="$2"
            shift 2
            ;;
        --launch-timeout)
            LAUNCH_TIMEOUT_SEC="$2"
            shift 2
            ;;
        --skip-docker)
            SKIP_DOCKER=1
            shift
            ;;
        --skip-env)
            SKIP_ENV=1
            shift
            ;;
        --include-installed-features)
            CHECK_INSTALLED_FEATURES=1
            shift
            ;;
        --with-robot-launch)
            SKIP_ROBOT=0
            shift
            ;;
        --skip-robot)
            SKIP_ROBOT=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

require_cmd(){
    command -v "$1" >/dev/null 2>&1 || {
        echo "Missing required command: $1" >&2
        exit 1
    }
}

require_file(){
    [ -e "$1" ] || {
        echo "Missing required file: $1" >&2
        exit 1
    }
}

installed_feature(){
    local feature="$1"
    grep -qx "$feature" "${INSTALLED:-/dev/null}" 2>/dev/null
}

check_docker(){
    echo "[1/2] Checking minimum Docker image and compose service..."
    require_cmd docker
    declare -a images=("arena:dev")
    declare -a services=("arena")

    if [ "$CHECK_INSTALLED_FEATURES" -eq 1 ] && installed_feature isaac; then
        images+=("arena_isaac:latest")
        services+=("isaac")
    fi
    if [ "$CHECK_INSTALLED_FEATURES" -eq 1 ] && installed_feature internnav; then
        images+=("arena_internnav:latest")
        services+=("internnav")
    fi

    local image
    for image in "${images[@]}"; do
        docker image inspect "$image" >/dev/null || {
            echo "Missing Docker image: $image" >&2
            echo "Re-run the relevant install command, for example: arena feature isaac install / arena feature internnav install" >&2
            exit 1
        }
        echo "  image ok: $image"
    done

    if ! docker compose version >/dev/null 2>&1; then
        echo "  docker compose plugin is not available in this shell; image checks passed."
    elif declare -F arena_docker_compose >/dev/null 2>&1; then
        local compose_services
        compose_services="$(arena_docker_compose config --services)"
        local service
        for service in "${services[@]}"; do
            grep -Fxq "$service" <<<"$compose_services" || {
                echo "Compose config is missing service: $service" >&2
                echo "$compose_services" >&2
                exit 1
            }
            echo "  compose service ok: $service"
        done
    else
        echo "  arena_docker_compose is not available in this shell; image checks passed."
    fi
}

check_environment(){
    echo "[2/2] Checking Arena ROS/Python environment..."
    require_cmd ros2
    require_file "${ARENA_WS_DIR}/install/local_setup.bash"
    require_file "${ARENA_DIR}/pyproject.toml"

    local pkg
    for pkg in arena_bringup arena_simulation_setup task_generator arena_vln_models; do
        ros2 pkg prefix "$pkg" >/dev/null || {
            echo "ROS package is not discoverable: $pkg" >&2
            echo "Run: arena build && arena validate bootstrap" >&2
            exit 1
        }
        echo "  ROS package ok: $pkg"
    done

    if [ "$CHECK_INSTALLED_FEATURES" -eq 1 ] && installed_feature isaac; then
        ros2 pkg prefix arena_isaac >/dev/null || {
            echo "Isaac feature is installed but arena_isaac is not discoverable." >&2
            exit 1
        }
        echo "  ROS package ok: arena_isaac"
    fi

    python - <<'PY'
import importlib

for module in (
    'arena_bringup',
    'arena_simulation_setup',
    'task_generator',
    'arena_vln_models',
):
    importlib.import_module(module)

print('  Python imports ok')
PY
}

check_robot_launch(){
    echo "[3/3] Checking minimum robot launch with dummy simulator..."
    require_cmd timeout
    require_cmd ros2

    # First parse the launch description without starting processes. This catches
    # missing packages, broken substitutions, and invalid launch-file syntax fast.
    ros2 launch arena_bringup arena.launch.py --show-args >/dev/null
    echo "  launch description ok"

    local log_file
    log_file="$(mktemp /tmp/arena_minimum_launch.XXXXXX.log)"
    local rc=0

    set +e
    timeout --preserve-status "${LAUNCH_TIMEOUT_SEC}s" \
        ros2 launch arena_bringup arena.launch.py \
            sim:=dummy \
            human:=dummy \
            robot:="$ROBOT" \
            world:="$WORLD" \
            headless:=2 \
            use_sim_time:=false \
            episodes:=1 \
            timeout:=5 \
            timeout_wall_sec:=10.0 \
            auto_reset:=false \
            local_planner:=dwb \
            global_planner:=navfn \
            tm_modules:=benchmark \
        >"$log_file" 2>&1 &
    local launch_pid=$!

    local observed=0
    local deadline=$((SECONDS + LAUNCH_TIMEOUT_SEC))
    while kill -0 "$launch_pid" 2>/dev/null && [ "$SECONDS" -lt "$deadline" ]; do
        if ros2 node list 2>/dev/null | grep -Eq '(^|/)task_generator_node|controller_server|planner_server|robot_state_publisher'; then
            observed=1
            break
        fi
        sleep 1
    done

    wait "$launch_pid"
    rc=$?
    set -e

    if [ "$observed" -ne 1 ]; then
        echo "Robot launch did not expose expected ROS nodes within ${LAUNCH_TIMEOUT_SEC}s." >&2
        echo "Last launch log lines:" >&2
        tail -80 "$log_file" >&2 || true
        exit 1
    fi

    # timeout exits 143/124 depending on signal/preserve-status. That is expected
    # because this smoke test intentionally bounds a long-running launch.
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ] && [ "$rc" -ne 143 ]; then
        echo "Robot launch exited unexpectedly with status $rc." >&2
        echo "Last launch log lines:" >&2
        tail -80 "$log_file" >&2 || true
        exit 1
    fi

    echo "  robot launch smoke ok: sim=dummy robot=${ROBOT} world=${WORLD}"
    rm -f "$log_file"
}

if [ "$SKIP_DOCKER" -ne 1 ]; then
    check_docker
fi
if [ "$SKIP_ENV" -ne 1 ]; then
    check_environment
fi
if [ "$SKIP_ROBOT" -ne 1 ]; then
    check_robot_launch
fi

echo "Arena minimum run test passed."
