#!/usr/bin/env bash

if [ -n "$ZSH_VERSION" ]; then
    shell='zsh'
    # shellcheck disable=SC2296
    THIS_FILE="${(%):-%N}"
    unsetopt PUSHD_IGNORE_DUPS
else
    shell='bash'
    THIS_FILE="${BASH_SOURCE[0]}"
fi
SOURCE_FILE=$(realpath "$THIS_FILE")
export SOURCE_FILE
export shell

# increase ulimit to fit pythonpath
current_stack=$(ulimit -s)
if [ "$current_stack" != "unlimited" ] && [ "$current_stack" -lt 65536 ]; then
    ulimit -s 65536 2>/dev/null || {
        echo "Warning: Could not increase stack limit to 65536KB (current: ${current_stack}KB)"
        echo "Consider running: echo '* soft stack 65536' | sudo tee -a /etc/security/limits.conf"
    }
fi
unset current_stack

ARENA_WS_DIR="${ARENA_WS_DIR:-$(pwd)}"

export ARENA_WS_DIR
export ARENA_DIR="$ARENA_WS_DIR/src/Arena"
export ARENA_FEATURES_DIR="${ARENA_FEATURES_DIR:-$ARENA_DIR/_meta/features}"

export INSTALLED="$ARENA_DIR/.installed"
export TOOLS_DIR="$ARENA_DIR/_meta/tools"
export ARENA_ASSETS_DIR="$ARENA_DIR/_assets/"
export ARENA_ASSETS_DIR_LOCAL="$ARENA_ASSETS_DIR/_local"
export ARENA_VENV_DIR="${ARENA_VENV_DIR:-$ARENA_DIR/.venv}"

export ARENA_ROS_DISTRO="${ARENA_ROS_DISTRO:-jazzy}"

export FASTRTPS_DEFAULT_PROFILES_FILE=${FASTRTPS_DEFAULT_PROFILES_FILE:-~/.ros/fastdds.xml}
# ~/.ros is on the container's ephemeral layer and is wiped whenever the container is
# recreated; regenerate the UDP-only FastDDS profile (SHM disabled: /dev/shm is tiny and
# arena<->isaac live in separate network namespaces) if it went missing.
if [ ! -f "$FASTRTPS_DEFAULT_PROFILES_FILE" ]; then
    mkdir -p "$(dirname "$FASTRTPS_DEFAULT_PROFILES_FILE")"
    cat > "$FASTRTPS_DEFAULT_PROFILES_FILE" <<'FASTDDS_PROFILE_XML'
<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>UdpTransport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_transport_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>UdpTransport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
FASTDDS_PROFILE_XML
fi
export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-1}
export RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/opt/ros/${ARENA_ROS_DISTRO}/lib/"
export ASSET_BUCKETS=${ARENA_ASSET_BUCKETS:-"default"}

resolve_arena_feature(){
    local feature="$1"
    if [ -f "$ARENA_FEATURES_DIR/${feature}" ] ; then
        echo "$ARENA_FEATURES_DIR/${feature}"
    elif [ -d "$ARENA_FEATURES_DIR/${feature}" ] && [ -f "$ARENA_FEATURES_DIR/${feature}/main" ] ; then
        echo "$ARENA_FEATURES_DIR/${feature}/main"
    else
        return 1
    fi
    return 0
}
export -f resolve_arena_feature

export ARENA_MODELS_FORMATS="yaml,png,jpg,mdl"

if [ -f "$INSTALLED" ]; then
    exit(){
        echo "Failed to source $1, skipping"
    }
    while read -r feature; do 
        if  feature_path="$(resolve_arena_feature "$feature")"; then
            source "$feature_path" source
        fi
    done < "$INSTALLED"
    unset -f exit
fi


if [ -f "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}" ] ; then
    . "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}"
fi
if [ -f install/local_setup.${shell} ] ; then
    . "install/local_setup.${shell}"
fi
if [ -f "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}" ] ; then
    . "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}"
fi


if [ -f "$ARENA_WS_DIR/.env" ] ; then
    set -a
    . "$ARENA_WS_DIR/.env"
    set +a
fi

if [ -z ${ARENA_SOURCED+x} ] ; then

    # stop rviz from flashing
    export QT_SCREEN_SCALE_FACTORS=1
    
    # python env
    pushd "$ARENA_DIR" > /dev/null || return 1
        if [ ! -f "$ARENA_VENV_DIR/.installed" ]; then
            uv venv "$ARENA_VENV_DIR" --allow-existing && \
            UV_PROJECT_ENVIRONMENT="$ARENA_VENV_DIR" uv sync --inexact --project . && \
            touch "$ARENA_VENV_DIR/.installed"
        fi

        # if [ "$venv_path" != "$VIRTUAL_ENV" ] ; then
        . "$ARENA_VENV_DIR/bin/activate"
        dirs=("$ARENA_VENV_DIR"/lib/*/site-packages)
        _IFS=$IFS IFS=':'
        export PYTHONPATH="${dirs[*]}:$PYTHONPATH"
        IFS=$_IFS
        unset _IFS
        unset dirs
        unset venv_path
    popd > /dev/null || return 1
    
    
    export ARENA_SOURCED=1
    PS1_BACKUP=$PS1
    export PS1="(Arena) $PS1"
    export PROMPT="(Arena) $PROMPT"
    echo 'sourced Arena environment'
    
    r2st(){ ros2 service call "$1" "$(ros2 service type "$1")";}
    
    arena(){
        local verb="$1"
        if [ -n "$verb" ] ; then
            shift
        fi

        pushd "$ARENA_WS_DIR" > /dev/null || return $?
        trap 'popd > /dev/null' EXIT
        
        case "$verb" in
            build)
                "${TOOLS_DIR}/colcon_build" "$@"
                . "$SOURCE_FILE"
                result=$?
            ;;
            update)
                "${TOOLS_DIR}/pull" "$@"
                result=$?
            ;;
            launch)
		        killall -s 9 task_generator_node && sleep 1
                ros2 launch arena_bringup arena.launch.py "$@"
                result=$?
            ;;
            deactivate)
                deactivate || true
                export PS1=$PS1_BACKUP
                unset PS1_BACKUP
                unset ARENA_SOURCED
                unset -f arena
                result=0
            ;;
            feature)
                features=$(ls "$ARENA_FEATURES_DIR" | paste -sd ' ' -)
                if [ $# -lt 1 ]; then
                    echo "Usage: arena feature <name> <install|uninstall|...>"
                    echo "Available features: $features"
                    result=1
                elif feature_path="$(resolve_arena_feature "$1")"; then
                    shift
                    # Quote each argument before splicing it into the -c string. A bare $*
                    # joins them with spaces and drops every quote, so an empty value passed
                    # as --flag "" disappears entirely and the flag arrives with nothing
                    # after it -- argparse then reports "expected one argument". Empty
                    # values and values containing spaces must both survive.
                    feature_args=""
                    for feature_arg in "$@"; do
                        feature_args+=" $(printf '%q' "$feature_arg")"
                    done
                    ($SHELL -c "source '$SOURCE_FILE' > /dev/null 2>&1 && $shell '$feature_path'$feature_args")
                    result=$?
                else
                    echo "Unknown feature '$1'" >&2
                    echo "Available features: $features"
                    result=1
                fi
            ;;
            *)
                echo 'Usage: arena <build|update|launch|deactivate|feature> [args...]'
                result=1
            ;;
        esac

        trap - EXIT
        popd > /dev/null || return $?
        return $result
    }
    
    export -f arena 2>/dev/null || true
fi