repositories:
  # build deps
  deps/pcl_msgs:
    type: git
    url: https://github.com/ros-perception/pcl_msgs.git
    version: ros2
  deps/actuator_msgs:
    type: git
    url: https://github.com/rudislabs/actuator_msgs.git
  deps/gps_umd:
    type: git
    url: https://github.com/swri-robotics/gps_umd.git
    version: ros2-devel
  deps/vision_msgs:
    type: git
    url: https://github.com/ros-perception/vision_msgs.git
    version: jazzy
  deps/vision_opencv:
    type: git
    url: https://github.com/ros-perception/vision_opencv.git
    version: humble

  # internal python toolchains
  deps/ament_cmake_venv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv
    version: humble
  deps/ament_cmake_venv_pyenv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv_pyenv
    version: master

  # internal management
  deps/arena_models:
    type: git
    url: https://github.com/voshch/arena-models
    version: master

  # deps/xacro:
  #   type: git
  #   url: https://github.com/ros/xacro.git
  #   version: ros2

  # deps/nav2/navigation2:
  # type: git
  # url: https://github.com/voshch/navigation2.git
  # version: jazzy
  # deps/nav2/bond_core:
  # type: git
  # url: https://github.com/ros/bond_core.git
  # version: ros2
  # deps/nav2/BehaviorTree.CPP:
  # type: git
  # url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
  # version: v3.8
  # deps/nav2/diagnostics:
  # type: git
  # url: https://github.com/ros/diagnostics.git
  # version: ros2
  # deps/nav2/angles:
  # type: git
  # url: https://github.com/ros/angles.git
  # version: ros2
  
  deps/slam_toolbox:
    type: git
    url: https://github.com/SteveMacenski/slam_toolbox.git
    version: jazzy

  # Social Force Model headers used by hunav_agent_manager. Upstream ships only a
  # Makefile whose `install` target copies them into /usr/local/include/lightsfm;
  # that path is baked into the container image and is not a bind mount, so every
  # `docker compose --force-recreate` silently reverted local edits to sfm.hpp.
  # Managed as a source package here instead, so edits rebuild like any other dep.
  deps/lightsfm:
    type: git
    url: https://github.com/Social-Nav/lightsfm.git
    version: feature/social_yielding
  # Social-Nav fork: carries the desired_velocity/radius echo-back and the
  # blackboard seeding for non-Regular behavior trees, neither of which can be
  # pushed to voshch/hunav_sim.
  deps/hunav/hunav_sim:
    type: git
    url: https://github.com/Social-Nav/hunav_sim.git
    version: feature/social_yielding
  deps/hunav/people_msgs:
    type: git
    url: https://github.com/wg-perception/people.git
    version: ros2
  # Social-Nav fork: carries arena_peds_to_people_bridge, which feeds /people.
  deps/hunav/arena_hunav_sim_bridge:
    type: git
    url: https://github.com/Social-Nav/arena_hunav_sim_bridge.git
    version: feature/social_yielding

  # social navigation (nav2 controller + costmap layer)
  # Was missing from every .repos file despite nav2_social_mpc_controller
  # depending on its ObstacleDistance msg, so `arena update` never cloned it and
  # a fresh workspace failed to build. Social-Nav fork carries the NO_OBSTACLE
  # sentinel fix for the uninitialised final_idx.
  deps/obstacle_distance_manager:
    type: git
    url: https://github.com/Social-Nav/obstacle_distance_manager.git
    version: feature/social_yielding
  deps/nav2_social_mpc_controller:
    type: git
    url: https://github.com/Social-Nav/nav2_social_mpc_controller.git
    version: feature/social_yielding
  deps/nav2_social_costmap_plugin:
    type: git
    url: https://github.com/robotics-upo/nav2_social_costmap_plugin.git
    version: humble
