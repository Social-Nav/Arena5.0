repositories:
  # build deps
  deps/pcl_msgs:
    type: git
    url: https://github.com/ros-perception/pcl_msgs.git
    version: ros2
  deps/actuator_msgs:
    type: git
    url: https://github.com/rudislabs/actuator_msgs.git
  deps/gps_umd:
    type: git
    url: https://github.com/swri-robotics/gps_umd.git
    version: ros2-devel
  deps/vision_msgs:
    type: git
    url: https://github.com/ros-perception/vision_msgs.git
    version: jazzy
  deps/vision_opencv:
    type: git
    url: https://github.com/ros-perception/vision_opencv.git
    version: humble

  # internal python toolchains
  deps/ament_cmake_venv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv
    version: humble
  deps/ament_cmake_venv_pyenv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv_pyenv
    version: master
  # buildtool_depend of arena_models; planners.repos declares it too, but only
  # under planners/deps/ and only when that feature is enabled.
  deps/ament_cmake_venv_uv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv_uv
    version: humble

  # internal management
  deps/arena_models:
    type: git
    url: https://github.com/voshch/arena-models
    version: master

  # deps/xacro:
  #   type: git
  #   url: https://github.com/ros/xacro.git
  #   version: ros2

  # deps/nav2/navigation2:
  # type: git
  # url: https://github.com/voshch/navigation2.git
  # version: jazzy
  # deps/nav2/bond_core:
  # type: git
  # url: https://github.com/ros/bond_core.git
  # version: ros2
  # deps/nav2/BehaviorTree.CPP:
  # type: git
  # url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
  # version: v3.8
  # deps/nav2/diagnostics:
  # type: git
  # url: https://github.com/ros/diagnostics.git
  # version: ros2
  # deps/nav2/angles:
  # type: git
  # url: https://github.com/ros/angles.git
  # version: ros2
  
  deps/slam_toolbox:
    type: git
    url: https://github.com/SteveMacenski/slam_toolbox.git
    version: jazzy

  # SFM headers for hunav_agent_manager.
  deps/lightsfm:
    type: git
    url: https://github.com/Social-Nav/lightsfm.git
    version: feature/social_yielding
  deps/hunav/hunav_sim:
    type: git
    url: https://github.com/Social-Nav/hunav_sim.git
    version: feature/social_yielding
  deps/hunav/people_msgs:
    type: git
    url: https://github.com/wg-perception/people.git
    version: ros2
  deps/hunav/arena_hunav_sim_bridge:
    type: git
    url: https://github.com/Social-Nav/arena_hunav_sim_bridge.git
    version: feature/social_yielding

  # social navigation (nav2 controller + costmap layer)
  deps/obstacle_distance_manager:
    type: git
    url: https://github.com/Social-Nav/obstacle_distance_manager.git
    version: feature/social_yielding
  deps/nav2_social_mpc_controller:
    type: git
    url: https://github.com/Social-Nav/nav2_social_mpc_controller.git
    version: feature/social_yielding
  deps/nav2_social_costmap_plugin:
    type: git
    url: https://github.com/robotics-upo/nav2_social_costmap_plugin.git
    version: humble
