{
  "schema": "arena.agentic.recording_contract.v1",
  "track": "A",
  "sensor_profile": "rgb_lidar",
  "bag_path": "recording/recording_0.db3",
  "recording_command": [
    "ros2",
    "bag",
    "record",
    "-o",
    "recording/recording_0",
    "/task_generator_node/Ai2_Bot2/head_camera/image",
    "/task_generator_node/Ai2_Bot2/head_camera/camera_info",
    "/task_generator_node/Ai2_Bot2/laser_scan",
    "/task_generator_node/Ai2_Bot2/odom",
    "/task_generator_node/Ai2_Bot2/cmd_vel"
  ],
  "open_mode": "ro",
  "required_types": {
    "rgb": ["sensor_msgs/msg/Image"],
    "camera_info": ["sensor_msgs/msg/CameraInfo"],
    "laser_scan": ["sensor_msgs/msg/LaserScan"]
  },
  "required_topics": {
    "rgb": ["/task_generator_node/Ai2_Bot2/head_camera/image"],
    "camera_info": ["/task_generator_node/Ai2_Bot2/head_camera/camera_info"],
    "laser_scan": ["/task_generator_node/Ai2_Bot2/laser_scan"]
  },
  "min_messages": {
    "rgb": 1,
    "camera_info": 1,
    "laser_scan": 1
  },
  "playback_policy": "BLOCKED_IF_REQUIRED_MISSING",
  "status": "CONTRACT_ONLY",
  "note": "Future A recordings must include RGB, CameraInfo, and real LaserScan. The current A bag is BLOCKED; this contract does not backfill history."
}
