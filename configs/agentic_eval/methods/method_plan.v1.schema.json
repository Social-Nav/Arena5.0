{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arena.agentic.method_plan.v1",
  "title": "Arena5 machine-readable method plan",
  "type": "object",
  "required": [
    "schema",
    "method_id",
    "role",
    "status",
    "runtime_status",
    "executable",
    "plan_only",
    "commands",
    "future_launch_command",
    "common_contract_hash",
    "common_contract",
    "method_private_hash",
    "bundle_source_digest",
    "canonical_bundle_path",
    "pinned_profile_sha256",
    "current_profile_sha256",
    "current_profile_drift",
    "common_case_blockers",
    "method_bundle",
    "errors",
    "blockers",
    "conflicts",
    "warnings",
    "launchable",
    "container",
    "ports",
    "topics",
    "namespace",
    "output_prefix",
    "source_binding",
    "lock",
    "cleanup",
    "note"
  ],
  "properties": {
    "schema": {"const": "arena.agentic.method_plan.v1"},
    "method_id": {
      "enum": [
        "internnav",
        "navila",
        "lightnav",
        "qwen_agent_proxmpc",
        "strict_b_on",
        "strict_b_off",
        "socialmpc_oracle"
      ]
    },
    "role": {"type": "string"},
    "status": {"enum": ["READY", "BLOCKED"]},
    "runtime_status": {"type": "string"},
    "executable": {"type": "boolean"},
    "plan_only": {"const": true},
    "commands": {"type": "array", "maxItems": 0},
    "future_launch_command": {"type": "array", "maxItems": 0},
    "common_contract_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "common_contract": {"type": "object"},
    "method_private_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bundle_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canonical_bundle_path": {"type": "string"},
    "pinned_profile_sha256": {"type": ["string", "null"]},
    "current_profile_sha256": {"type": ["string", "null"]},
    "current_profile_drift": {"type": "boolean"},
    "common_case_blockers": {"type": "array", "items": {"type": "string"}},
    "method_bundle": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "launchable": {"type": "boolean"},
    "container": {"type": ["string", "null"]},
    "ports": {"type": "array", "items": {"type": "integer"}},
    "topics": {"type": "object"},
    "namespace": {"type": ["string", "null"]},
    "output_prefix": {"type": ["string", "null"]},
    "source_binding": {"type": ["string", "null"]},
    "lock": {"type": ["object", "null"]},
    "cleanup": {"type": "array", "items": {"type": "string"}},
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
